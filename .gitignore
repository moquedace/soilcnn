# R artifacts
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Large data and model outputs (do not commit binaries or processed data)
data/
outputs/
*.rds
*.pt
*.tif
*.gpkg
*.csv
*.zip

# Runtime logs
logs/

# OS
.DS_Store
Thumbs.db

# Vignettes built by devtools::build_vignettes()
/doc/
/Meta/

# Python bytecode of tools/
__pycache__/

# The SOC project the package was developed on, and the author's own editing
# helpers: kept beside the package on disk, not in its repository (2026-09-28)
examples/
utils/
docs/project_log.md
docs/status_and_roadmap.md
docs/test_plan.md
docs/archive/
tools/*.py

# Pilot reports (docx) kept locally only
docs/pilot_reports/

# Figure inputs (28 m rasters) and the records of where each figure came from.
tools/figure_inputs/

# The example landscape the package ships (data-raw/make_example_landscape.R):
# small, made by code, and needed by the examples, the tests and the vignette.
!inst/extdata/**/*.tif
!inst/extdata/**/*.csv

# pkgdown site, built locally (CI publishes it to gh-pages)
site/
