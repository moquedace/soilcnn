# Scripts e texto: LF no repositorio, checkout nativo no Windows
*.R      text eol=lf
*.md     text eol=lf
*.Rmd    text eol=lf
*.Rd     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Binarios: nunca normalizar
*.rds    binary
*.pt     binary
*.tif    binary
*.gpkg   binary
*.png    binary
*.svg    text eol=lf
*.zip    binary

# Package metadata: no extension, so named one by one
DESCRIPTION    text eol=lf
NAMESPACE      text eol=lf
LICENSE        text eol=lf
.Rbuildignore  text eol=lf
CITATION       text eol=lf
